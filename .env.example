# Copia este ficheiro para .env e preenche os valores reais.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/kairos
# Em produção, define uma chave aleatória longa (pelo menos 32 caracteres).
JWT_SECRET=SUBSTITUIR_POR_UMA_CHAVE_ALEATORIA_LONGA
ADMIN_EMAIL=admin@kairos.co.mz
# Palavra-passe temporária forte; será usada para criar o primeiro administrador.
ADMIN_PASSWORD=SUBSTITUIR_POR_UMA_PALAVRA_PASSE_FORTE
# Opcional: URL pública do website para CORS; se vazio, mesma origem.
PUBLIC_URL=
# WhatsApp no formato internacional sem +, por exemplo 2588XXXXXXXX
WHATSAPP_NUMBER=
